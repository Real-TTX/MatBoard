<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Company>Matthias Schmoldt</Company>
    <Product>MatBoard</Product>
    <Authors>Matthias Schmoldt</Authors>
  </PropertyGroup>

  <!-- Versioning (single source of truth: Major/Minor below). CI overrides Channel / BuildNumber / BuildDate:
         release : <major>.<minor>.<build>-<date>   e.g. 0.1.42-20261031   (branch main)
         nightly : nightly-<build>-<date>                                  (branch dev)
         local   : local-<date>                                            (everything else, the local stack) -->
  <PropertyGroup>
    <MatBoardMajor>0</MatBoardMajor>
    <MatBoardMinor>1</MatBoardMinor>

    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <Channel Condition="'$(Channel)' == ''">local</Channel>
    <BuildDate Condition="'$(BuildDate)' == ''">$([System.DateTime]::UtcNow.ToString('yyyyMMdd'))</BuildDate>

    <Version>$(MatBoardMajor).$(MatBoardMinor).$(BuildNumber)</Version>
    <AssemblyVersion>$(MatBoardMajor).$(MatBoardMinor).0.0</AssemblyVersion>
    <FileVersion>$(MatBoardMajor).$(MatBoardMinor).0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Channel)' == 'release'">
    <InformationalVersion>$(MatBoardMajor).$(MatBoardMinor).$(BuildNumber)-$(BuildDate)</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Channel)' == 'nightly'">
    <InformationalVersion>nightly-$(BuildNumber)-$(BuildDate)</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Channel)' == 'local'">
    <InformationalVersion>local-$(BuildDate)</InformationalVersion>
  </PropertyGroup>

</Project>
