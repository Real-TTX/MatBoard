@page "/Admin/System"
@model MatBoard.Pages.Admin.SystemModel
@{
    ViewData["Title"] = L["System.Title"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Admin.Title"].Value, null), (L["System.Title"].Value, null) };
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-7">
        <form class="mat-form" method="post" novalidate>
            <partial name="_FormSummary" model="ViewData.ModelState" />
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("settings")@L["System.Settings"]</h2></div>
                <div class="mat-card__body mat-form">
                    <mb-field name="RegistrationOpen" kind="switch" label="@L["System.RegistrationOpen"]" value="@Model.RegistrationOpen.ToString()" hint="@L["System.RegistrationOpen.Hint"]" />
                    <mb-field name="PublicUrl" kind="url" label="@L["System.PublicUrl"]" value="@Model.PublicUrl" placeholder="https://board.example.com" optional hint="@L["System.PublicUrl.Hint"]" />
                </div>
            </div>
            <mb-buttons save="@L["Common.Save"]" back="/Boards" />
        </form>
    </div>
    <div class="mat-col-12 mat-col-lg-5">
        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("info")@L["System.About"]</h2></div>
            <div class="mat-card__body">
                <dl class="mb-dl">
                    <dt>@L["System.Version"]</dt><dd class="mat-mono">@AppInfo.Version</dd>
                    <dt>@L["System.Database"]</dt><dd class="mat-mono">@Model.Database</dd>
                    <dt>@L["Users.Title"]</dt><dd>@Model.Counts.Users</dd>
                    <dt>@L["Boards.Title"]</dt><dd>@Model.Counts.Boards</dd>
                    <dt>@L["System.SharedBoards"]</dt><dd>@Model.Counts.SharedBoards</dd>
                    <dt>@L["System.LinkedBoards"]</dt><dd>@Model.Counts.LinkedBoards</dd>
                    <dt>@L["System.Items"]</dt><dd>@Model.Counts.Items</dd>
                    <dt>@L["System.Mail"]</dt><dd>@(Model.MailText ?? L["System.Mail.Off"].Value)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
