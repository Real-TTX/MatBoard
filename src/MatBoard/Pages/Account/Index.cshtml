@page "/Account"
@model MatBoard.Pages.Account.IndexModel
@{
    ViewData["Title"] = L["Settings.Profile"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Settings.Title"].Value, null), (L["Settings.Profile"].Value, null) };
    ViewData["Width"] = "narrow";
    var swatches = string.Join(",", BoardService.CursorColors.Select(c => $"{c.Value}:{c.Name}"));
}

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />
    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("user")@L["Settings.Profile"]</h2></div>
        <div class="mat-card__body mat-form">
            <mb-field name="DisplayName" label="@L["Account.Name"]" required value="@Model.DisplayName" maxlength="120" autocomplete="name" msg-required="@L["Account.Name.Required"]" />
            <mb-field name="EmailShown" kind="email" label="@L["Account.Email"]" value="@Model.Email" disabled hint="@L["Settings.Email.Hint"]" />
            <mb-field name="Language" kind="radios" label="@L["Common.Language"]" value="@Model.Language" options="Model.LanguageChoices" />
            <mb-field name="TimeZone" kind="picker" label="@L["Settings.TimeZone"]" value="@Model.TimeZone" options="Model.Zones" picker="search" hint="@L["Settings.TimeZone.Hint"]" />
            <mb-field name="Scheme" kind="radios" label="@L["Settings.Scheme"]" value="@Model.Scheme" options="Model.Schemes" />
        </div>
    </div>
    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("layout")@L["Settings.Boards"]</h2></div>
        <div class="mat-card__body mat-form">
            <mb-field name="CursorColor" kind="colour" label="@L["Settings.CursorColor"]" value="@Model.CursorColor" picker="swatches=@swatches" hint="@L["Settings.CursorColor.Hint"]" />
            @if (Model.MailAvailable)
            {
                <mb-field name="MailOnShare" kind="switch" label="@L["Settings.MailOnShare"]" value="@Model.MailOnShare.ToString()" hint="@L["Settings.MailOnShare.Hint"]" />
            }
        </div>
    </div>
    <mb-buttons save="@L["Common.Save"]" back="/Boards" />
</form>
